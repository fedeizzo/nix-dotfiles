default:
    @just --list

# Format the code (Rust + Svelte/TS)
fmt:
    cargo fmt
    cd frontend && npm run format

# Run linters (Clippy + ESLint)
lint:
    cargo clippy -- -W clippy::pedantic
    cd frontend && npm run lint

# Run all tests using standard cargo test
test:
    cargo test

# Run all tests using nextest for beautiful output
nextest:
    cargo nextest run --status-level pass

# Continuously watch for changes and run nextest
watch:
    cargo watch -x "nextest run"

# Run test coverage with cargo-tarpaulin
coverage:
    cargo tarpaulin

# Build the frontend and the Rust binary
build:
    cd frontend && npm run build
    cargo build

# Run the application (builds frontend first)
run *ARGS:
    cd frontend && npm run build
    cargo run -- {{ARGS}}

# Run the frontend dev server (Vite hot-reload)
dev-front:
    cd frontend && npm run dev

# Run Svelte type checking
check-front:
    cd frontend && npm run check

# Run the backend dev server (Rust hot-reload)
dev-back:
    cargo watch -x run

# Run BOTH frontend and backend dev servers with hot-reload!
dev:
    npx concurrently -c "green,blue" -n "SVELTE,RUST" "cd frontend && npm run dev" "cargo watch -x run"

# Run all formatting, linting, and tests (Run this before you commit!)
check: fmt lint check-front nextest
