# Fish Audio Drama-3 speech synthesis (`fish-drama3-tts` provider, `gufo serve tts`)
# served by gufo with the fish_drama3 extension (see gufo-fish-drama3.nix).
# Weights: `huggingface_hub` download of fishaudio/drama-3 (15 BF16 safetensors
# shards + codec.pth DAC codec) in /persist/models/store/Fish-Drama-3, reached
# through the generated by-capability/audio symlink (see scripts/model-store).
{
  flake.modules.nixos.llama-swap-fish-drama3 = { inputs, pkgs, ... }:
    let
      gufoFishDrama3 = inputs.gufo.lib.${pkgs.stdenv.hostPlatform.system}.mkGufoServe {
        gufoPackage = pkgs.gufo-fish-drama3;
        modality = "tts";
        provider = "fish-drama3-tts";

        model = "/persist/models/by-capability/audio/Fish-Drama-3";
        servedModelName = "fish-drama3";
        host = "0.0.0.0";
        port = "\${PORT}";
        maxRequestBytes = 33554432;

        # Reference voices for zero-shot cloning (the fish-drama3-tts provider
        # advertises serving.voices). Same reference clips and transcripts as
        # qwen-tts; `text` is the transcript itself or a path holding it.
        #
        # No `language` here: Drama-3 clones from the reference audio and keys
        # the take with a `<|speaker:N|>` tag in the prompt, so it has no
        # per-voice language hint like the Qwen TTS provider.
        voices = {
          narrator_eng = {
            wav = "/persist/models/samples/clear-english-voice.wav";
            text = "/persist/models/samples/clear-english-voice.txt";
          };

          narrator_ita = {
            wav = "/persist/models/samples/clear-italian-voice.wav";
            text = "/persist/models/samples/clear-italian-voice.txt";
          };

          me = {
            wav = "/persist/models/samples/me.wav";
            text = "ciao il mio nome è Federico sono un ingegnere informatico vivo a Parigi e nel tempo libero mi piace arrampicare";
          };
        };
      };
    in
    {
      imports = [ inputs.self.modules.nixos.llama-swap-gufo-fish-drama3 ];
      services.llama-swap.settings.models."fish-drama3" = {
        env = [ "LLAMA_CACHE=/persist/models" "GPU_MAX_HW_QUEUES=1" ];
        cmd = "${gufoFishDrama3}";
        checkEndpoint = "/ready"; # gufo /health answers 200 during loading; /ready gates on model readiness
        # 40-layer MoE backbone + codec: loading is far slower than the LFM3
        # family, so stay warm longer before unloading.
        ttl = 600;
        timeouts.responseHeader = 600;
        aliases = [ ];
      };
    };
}
